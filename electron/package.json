{
  "name": "supermarket-billing-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop build for StoreDesk supermarket billing software.",
  "author": "StoreDesk",
  "main": "main.cjs",
  "scripts": {
    "bundle:backend": "esbuild ../server/src/server.js --bundle --platform=node --format=cjs --outfile=backend/server.cjs --external:mongodb-client-encryption --external:kerberos --external:snappy --external:@mongodb-js/zstd --external:aws4",
    "dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dist:win": "npm run bundle:backend && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.0"
  },
  "build": {
    "appId": "com.storedesk.supermarketbilling",
    "productName": "StoreDesk POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client/dist"
      },
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
